<IfModule mod_rewrite.c>
    RewriteEngine On
    # RewriteBase must be set to the relative path from DocumentRoot to this directory
    # For portability, update this if you rename the folder (e.g., /new_folder_name/public/)
    RewriteBase /yip_remote/public/

    RewriteRule ^index\.html$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . index.php [L]
</IfModule>
